# Copia in .env.local e compila con i valori del progetto Supabase (Settings → API).
# Non inserire mai la service role nel bundle client-only.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Opzionale: chiave “publishable” al posto della legacy anon (Supabase nuove dashboard)
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo server (azioni admin / bypass RLS): mai esporre al browser
# SUPABASE_SERVICE_ROLE_KEY=

# URL pubblico del sito (link /book, redirect email)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
